{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api(?:/(.*))?",
      "dest": "/api/index.js"
    },
    {
      "src": "/(?:login)?/?",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/marcaciones/?",
      "dest": "/frontend/marcaciones.html"
    },
    {
      "src": "/(?:admin|administracion)/?",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "/reportes/?",
      "dest": "/frontend/reportes.html"
    },
    {
      "src": "/(css|js)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(.*\\.(?:png|jpg|jpeg|gif|svg|ico|webp|woff|woff2))",
      "dest": "/frontend/$1"
    }
  ]
}
